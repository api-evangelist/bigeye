        {
          "info": {
            "name": "Delete all edges for a node",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.bigeye.com/api/v1/lineage/nodes/:dataNodeId/relationships",
            "params": [
              {
                "name": "dataNodeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete all edges for a node"
