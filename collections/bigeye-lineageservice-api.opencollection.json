              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get downstream nodes for a given node"
        },
        {
          "info": {
            "name": "Get an edge by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.bigeye.com/api/v1/lineage/relationships/:lineageRelationshipId",
