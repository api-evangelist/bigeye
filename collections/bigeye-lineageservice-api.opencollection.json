        },
        {
          "info": {
            "name": "Delete an edge by ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.bigeye.com/api/v1/lineage/relationships/:lineageRelationshipId",
            "params": [
              {
                "name": "lineageRelationshipId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an edge by ID"
        },
        {
          "info": {
            "name": "Get all edges for a node",
            "type": "http"
