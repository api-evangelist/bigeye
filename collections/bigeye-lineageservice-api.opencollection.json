{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metadata Lineage Service API",
    "version": "version not set"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "LineageService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a custom node",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.bigeye.com/api/v1/lineage/nodes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a custom node"
        },
        {
          "info": {
            "name": "Create a custom edge between two nodes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.bigeye.com/api/v1/lineage/relationships",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a custom edge between two nodes"
        },
        {
          "info": {
            "name": "Get a node by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
